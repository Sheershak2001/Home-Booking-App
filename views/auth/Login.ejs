<%- include('../partials/head') %> 
</head>
<body>
  <%- include('../partials/nav') %>
  <header class=" text-black p-4 flex justify-center">
    <h1 class="text-2xl font-bold text-center">Login Page</h1>
  </header>
  <main class="p-2">

    <form action="/login" method="POST" class="max-w-md mx-auto">

      <%- include('../partials/errors') %>

      <input 
        type="email" 
        name="email" 
        required
        value="<%= oldInput.email ? oldInput.email : '' %>"
        placeholder="Email Address" 
        class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-gray-500" />
      <input 
        type="password" 
        name="password" 
        required
        placeholder="Password" 
        class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-gray-500" />
      
      
      <button 
        type="submit" 
        value="Sign In"
        class="w-full bg-gray-600 text-white py-2 rounded-md hover:bg-gray-700 transition duration-300">Sign In</button>
    </form>
  </main>
</body>
</html>