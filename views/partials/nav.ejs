<header class="bg-teal-500 text-white p-4 shadow-md">
  <nav class="container mx-auto flex justify-between items-center">
    <ul class="flex space-x-4">
      <li>
        <a
          href="/"
          class="<%= currentPage === 'index' ? 'bg-teal-800' : 'hover:bg-teal-700' %> py-2 px-4 rounded transition duration-300"
        >
          Home
        </a>
      </li>

      <% if (isLoggedIn) { %>
        <% if (user && user.userType === 'guest') { %>
          <li>
            <a
              href="/homes"
              class="<%= currentPage === 'Home' ? 'bg-teal-800' : 'hover:bg-teal-700' %> py-2 px-4 rounded transition duration-300"
            >
              Homes
            </a>
          </li>
          <li>
            <a
              href="/bookings"
              class="<%= currentPage === 'bookings' ? 'bg-teal-800' : 'hover:bg-teal-700' %> py-2 px-4 rounded transition duration-300"
            >
              Bookings
            </a>
          </li>
          <li>
            <a
              href="/favourites"
              class="<%= currentPage === 'favourites' ? 'bg-teal-800' : 'hover:bg-teal-700' %> py-2 px-4 rounded transition duration-300"
            >
              Favourites
            </a>
          </li>
        <% } else { %>
          <li>
            <a
              href="/host/add-home"
              class="<%= currentPage === 'addHome' ? 'bg-teal-800' : 'hover:bg-teal-700' %> py-2 px-4 rounded transition duration-300"
            >
              Add Home
            </a>
          </li>
          <li>
            <a
              href="/host/host-home-list"
              class="<%= currentPage === 'host-Homes' ? 'bg-teal-800' : 'hover:bg-teal-700' %> py-2 px-4 rounded transition duration-300"
            >
              Host Homes
            </a>
          </li>
        <% } %>
      <% } %>

      <% if (!isLoggedIn) { %>
        <li>
          <a
            href="/signup"
            class="<%= currentPage === 'signup' ? 'bg-teal-800' : 'hover:bg-teal-700' %> py-2 px-4 rounded transition duration-300"
          >
            Sign Up
          </a>
        </li>
        <li>
          <a
            href="/login"
            class="<%= currentPage === 'login' ? 'bg-teal-800' : 'hover:bg-teal-700' %> py-2 px-4 rounded transition duration-300"
          >
            Login
          </a>
        </li>
      <% } else { %>
        <li>
          <form action="/logout" method="POST">
            <button 
              type="submit"
              value="Logout"
              class="<%= currentPage === 'logout' ? 'bg-teal-800' : 'hover:bg-teal-700' %> py-2 px-4 rounded transition duration-300"
            >
              Logout
            </button> 
          </form>
        </li>
      <% } %>
    </ul>
  </nav>
</header>
