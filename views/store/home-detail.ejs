
<%- include('../partials/head') %> 
</head>
<body>
  <%- include('../partials/nav') %>
  <main class="container bg-white mx-auto shadow-lg rounded-lg p-5 max-w-4xl h-full">
    <h1 class="text-2xl text-gray-600 font-bold text-center mb-9">Home Deatils :</h1>
    <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition duration-300 w-full h-70 flex justify-center">
      <img src="<%= home.photoUrl || '/images/home1.jpg' %>" onerror="this.onerror=null; this.src='/images/home1.jpg';" alt="<%= home.homeName %>" class="w-95 h-70 p-4 object-cover">
      <div class="p-2 flex flex-col justify-between items-start">
        <h3 class="text-xl font-semibold text-gray-800"><%= home.homeName %></h3>
        <p class="text-xl font-semibold text-gray-800"><i class="fas fa-map-marker-alt">Location:</i> <%= home.homeAddress %></p>
        <p class="text-lg font-bold text-gray-500"><strong>Price:</strong> $<%= home.price %></p>
        <p class="text-gray-600"><strong>Rating:</strong> <%= home.rating %>/10</p>
        <a href="<%= home.photoUrl || '/images/home1.jpg' %>" target="_blank" class="text-blue-600 hover:underline font-semibold">View Photo</a>
        
        <%- include('../partials/favourites') %>
      </div>
    </div>
  </main>

</body>
</html>