<%- include('../partials/head') %> 
</head>
<body>
  <%- include('../partials/nav') %>
  <header class=" text-black p-4 flex justify-center">
    <h1 class="text-2xl font-bold text-center">Register</h1>
  </header>
  <main class="p-2">

    <form action="/signup" method="POST" class="max-w-md mx-auto">

      <%- include('../partials/errors') %>
      
      <div class="flex">
        <input 
          type="text" 
          name="firstName" 
          value="<%= oldInput.firstName ? oldInput.firstName : '' %>"
          required
          placeholder="First Name" 
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-gray-500" />
        <input 
          type="text" 
          name="lastName" 
          value="<%= oldInput.lastName ? oldInput.lastName : '' %>"
          placeholder="Last Name" 
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-gray-500" />
        </div>
      <input 
        type="email" 
        name="email" 
        value="<%= oldInput.email ? oldInput.email : '' %>"
        required
        placeholder="Email Address" 
        class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-gray-500" />
      <input 
        type="password" 
        name="password" 
        required
        placeholder="Password" 
        class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-gray-500" />
      <input 
        type="password" 
        name="confirmPassword" 
        required
        placeholder="Confirm Password" 
        class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-gray-500" />

      <div class="mb-4 flex gap-6">
        <p>User Type: </p>
        <label for="guest">
          <input type="radio" name="userType" value="guest" id="guest" <%= (oldInput && oldInput.userType === 'guest') ? 'checked' : '' %> /> <span>guest</span>
        </label> 
        <label for="host">
          <input type="radio" name="userType" value="host" id="host" class="mr-2" <%= (oldInput && oldInput.userType === 'host') ? 'checked' : '' %> /> <span>host</span>
        </label>
      </div>

      <div class="mb-4">
        <input type="checkbox" name="terms" id="terms" class="mr-2" required />
        <label for="terms">I agree to the <a href="/terms" class="text-blue-500 hover:underline">Terms and Conditions</a></label>
        <br />
      </div>

      <button 
        type="submit" 
        value="Sign Up"
        class="w-full bg-gray-600 text-white py-2 rounded-md hover:bg-gray-700 transition duration-300">Register -></button>
    </form>
    <br />
    <p class="text-center">
      Already have an account? <a href="/login" class="text-blue-500 hover:underline">Login here</a>
    </p>
  </main>
</body>
</html>